# Database connection string (MySQL example)
DATABASE_URL="mysql://root@localhost:3306/lettre_db"

# OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# JWT secrets — use long random strings (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string

# Server port (optional, defaults to 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development
